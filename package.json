{
    "name": "weapp-gulp-service",
    "version": "2.0.0",
    "description": "微信小程序预编译工作流 & weapp precompile workflow, powered by deltic",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "wgs": "bin/wgs.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "bin",
        "templates"
    ],
    "scripts": {
        "prepare": "pnpm build",
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "preinstall": "npx only-allow pnpm",
        "preversion": "pnpm test",
        "version": "git add -A",
        "postversion": "git push && git push --tags"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/lixl39505/weapp-gulp-service.git"
    },
    "keywords": [
        "小程序",
        "wx",
        "miniprogram",
        "alias",
        "compile"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "peerDependencies": {
        "miniprogram-ci": "^1.0.83"
    },
    "peerDependenciesMeta": {
        "miniprogram-ci": {
            "optional": true
        }
    },
    "dependencies": {
        "camelcase": "^6.3.0",
        "chokidar": "^5.0.0",
        "commander": "^15.0.0",
        "dashify": "^2.0.0",
        "deltic": "file:../deltic",
        "fast-glob": "^3.3.3",
        "htmlparser2": "^10.0.0",
        "jiti": "^2.7.0",
        "less": "^4.2.0",
        "picocolors": "^1.1.1",
        "postcss": "^8.4.41",
        "postcss-px2rpx": "0.0.4",
        "requireg": "^0.2.2",
        "semver": "^7.3.5",
        "streamx": "^2.28.1",
        "vinyl": "^3.0.1"
    },
    "devDependencies": {
        "@types/less": "^3.0.8",
        "@types/node": "^26.6.3",
        "@types/semver": "^7.5.8",
        "@types/vinyl": "^2.0.12",
        "@vitest/coverage-istanbul": "^5.0.2",
        "clean-css": "^5.1.3",
        "html-minifier-terser": "^5.1.1",
        "prettier": "^3.3.1",
        "terser": "^5.7.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.2"
    }
}
